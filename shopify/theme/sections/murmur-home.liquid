<section class="murmur-home" aria-label="MURMUR home">
  <div class="murmur-hero">
    <img class="murmur-hero__image" src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-cowl-hero.png?v=1788915784" alt="MURMUR COWL in Bone, Ink and Indigo" width="1536" height="2048" loading="eager">
    <div class="murmur-hero__shade"></div>
    <div class="murmur-hero__copy">
      <p class="murmur-kicker">MURMUR / CURRENT 01</p>
      <h1>COWL</h1>
      <p class="murmur-deck">GARMENTS AS SYSTEMS.</p>
      <p class="murmur-intro">Architectural outerwear built around a removable internal architecture. Fashion first. The system disappears into the structure.</p>
      <div class="murmur-actions"><a href="/collections/wear">EXPLORE WEAR</a><a href="/pages/system">THE SYSTEM</a></div>
    </div>
  </div>

  <div class="murmur-statement">
    <p class="murmur-kicker">MOLT / CORE SYSTEM</p>
    <h2>ONE SPINE.<br>MANY LAYERS.</h2>
    <p>MURMUR separates the garment from the infrastructure beneath it. Structure, routing and future modules remain removable, serviceable and able to move between compatible layers.</p>
  </div>

  <div class="murmur-duo">
    <a class="murmur-tile" href="/collections/wear"><img src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-wear-collection.png?v=1788915887" alt="MURMUR WEAR collection" width="1536" height="2048" loading="lazy"><span class="murmur-tile__label"><b>WEAR</b><small>THE VISIBLE LAYER</small></span></a>
    <a class="murmur-tile" href="/collections/molt"><img src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-molt-collection.png?v=1788915899" alt="MURMUR MOLT modular system" width="1536" height="2048" loading="lazy"><span class="murmur-tile__label"><b>MOLT</b><small>THE REMOVABLE BACKBONE</small></span></a>
  </div>

  <div class="murmur-system-head"><p class="murmur-kicker">SYSTEM / DETAILS</p><h2>BUILT TO CHANGE.</h2></div>

  <div class="murmur-grid">
    <article><img src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-cowl-system-map.png?v=1788915796" alt="COWL routing and service architecture" width="1536" height="2048" loading="lazy"><div><b>01 / COWL</b><span>Routing / Service / Integration</span></div></article>
    <article><img src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-molt-core-system.png?v=1788915809" alt="MOLT CORE removable spine and harness" width="1536" height="2048" loading="lazy"><div><b>02 / MOLT CORE</b><span>Carry / Stabilize / Reconfigure</span></div></article>
    <article><img src="https://cdn.shopify.com/s/files/1/0748/5839/7847/files/murmur-veil-lookbook.png?v=1788915822" alt="MURMUR VEIL translucent modular overlay" width="1536" height="2048" loading="lazy"><div><b>03 / VEIL</b><span>Layer / Adapt / Disappear</span></div></article>
  </div>

  <div class="murmur-closing"><p class="murmur-kicker">MURMUR / DEVELOPMENT</p><h2>HUMAN.<br>MACHINE.<br>ENVIRONMENT.</h2><a href="/pages/system">READ THE SYSTEM →</a></div>
</section>

<style>
.murmur-home{--bone:#e8e3d9;--ink:#0f1115;--indigo:#24263b;--mist:#a4a3ad;background:var(--bone);color:var(--ink);margin:0;overflow:hidden}.murmur-home *{box-sizing:border-box}.murmur-kicker{font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin:0 0 18px;font-weight:600}.murmur-hero{height:min(92svh,980px);min-height:620px;position:relative;background:var(--ink);overflow:hidden}.murmur-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 28%}.murmur-hero__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,17,21,.08) 20%,rgba(15,17,21,.78) 100%),linear-gradient(90deg,rgba(15,17,21,.45),transparent 60%)}.murmur-hero__copy{position:absolute;left:clamp(24px,6vw,90px);bottom:clamp(36px,7vw,92px);max-width:720px;color:#f2eee6}.murmur-hero h1{font-size:clamp(76px,14vw,210px);font-weight:500;line-height:.78;letter-spacing:.03em;margin:0 0 28px;text-transform:uppercase}.murmur-deck{font-size:clamp(18px,2.2vw,32px);letter-spacing:.12em;margin:0 0 18px}.murmur-intro{font-size:14px;line-height:1.65;max-width:560px;color:rgba(242,238,230,.83)}.murmur-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.murmur-actions a,.murmur-closing a{display:inline-block;border:1px solid currentColor;color:inherit;text-decoration:none;padding:13px 18px;font-size:11px;letter-spacing:.16em;transition:.25s}.murmur-actions a:hover,.murmur-closing a:hover{background:#f2eee6;color:var(--ink)}.murmur-statement{padding:clamp(70px,11vw,170px) clamp(24px,8vw,120px);display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:8vw;align-items:end}.murmur-statement .murmur-kicker{grid-column:1/-1}.murmur-statement h2,.murmur-system-head h2,.murmur-closing h2{font-size:clamp(48px,8vw,118px);line-height:.9;letter-spacing:.02em;font-weight:500;margin:0}.murmur-statement>p:last-child{font-size:15px;line-height:1.8;max-width:520px;color:#41424a}.murmur-duo{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);gap:1px}.murmur-tile{position:relative;height:74svh;min-height:560px;overflow:hidden;color:#fff;text-decoration:none;background:var(--ink)}.murmur-tile img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.murmur-tile:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(15,17,21,.75))}.murmur-tile:hover img{transform:scale(1.025)}.murmur-tile__label{position:absolute;z-index:2;left:clamp(24px,4vw,60px);bottom:clamp(24px,4vw,60px);display:flex;flex-direction:column;gap:7px}.murmur-tile__label b{font-size:clamp(34px,5vw,78px);font-weight:500;letter-spacing:.06em}.murmur-tile__label small{font-size:10px;letter-spacing:.22em}.murmur-system-head{padding:clamp(70px,10vw,140px) clamp(24px,6vw,90px) clamp(40px,6vw,78px);background:var(--ink);color:var(--bone)}.murmur-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#383a45}.murmur-grid article{background:var(--ink);color:var(--bone)}.murmur-grid img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover}.murmur-grid article div{padding:22px 24px 34px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.murmur-grid b{font-size:11px;letter-spacing:.16em}.murmur-grid span{font-size:10px;letter-spacing:.08em;color:var(--mist);text-align:right}.murmur-closing{background:var(--indigo);color:#f2eee6;padding:clamp(80px,12vw,180px) clamp(24px,8vw,120px)}.murmur-closing h2{max-width:1000px;margin-bottom:46px}.murmur-closing a:hover{background:#f2eee6;color:var(--indigo)}
@media(max-width:760px){.murmur-hero{height:82svh;min-height:580px}.murmur-hero__image{object-position:55% center}.murmur-hero h1{font-size:clamp(68px,22vw,110px)}.murmur-statement{grid-template-columns:1fr;gap:28px}.murmur-statement .murmur-kicker{grid-column:auto}.murmur-duo{grid-template-columns:1fr}.murmur-tile{height:68svh;min-height:500px}.murmur-grid{grid-template-columns:1fr}.murmur-grid img{aspect-ratio:4/5}.murmur-grid article div{padding-bottom:30px}}
</style>

