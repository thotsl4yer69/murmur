<link rel="stylesheet" href="{{ 'murmur-system.css' | asset_url }}">
<a href="{{ routes.root_url }}" class="murmur-wordmark" aria-label="MURMUR home" {{ block.shopify_attributes }}>MURMUR</a>

{% stylesheet %}
.murmur-wordmark{display:flex;align-items:center;height:100%;font-family:var(--font-accent--family);font-size:1rem;font-weight:500;letter-spacing:.28em;line-height:1;color:var(--color-foreground);text-decoration:none;text-transform:uppercase;white-space:nowrap}.murmur-wordmark:hover{text-decoration:none;opacity:.68}@media(max-width:749px){.murmur-wordmark{font-size:.9rem;letter-spacing:.22em}}
{% endstylesheet %}

{% schema %}
{
  "name":"MURMUR Wordmark",
  "tag":null,
  "class":"header-logo",
  "settings":[
    {"type":"checkbox","id":"hide_logo_on_home_page","label":"Hide wordmark on home page","default":false},
    {"type":"range","id":"padding-block-start","label":"Top padding","min":0,"max":100,"step":1,"unit":"px","default":0},
    {"type":"range","id":"padding-block-end","label":"Bottom padding","min":0,"max":100,"step":1,"unit":"px","default":0}
  ]
}
{% endschema %}
